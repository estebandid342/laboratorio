#include <iostream>
using namespace std;

int main() {
    int dia, mes, anio;

    cout << "Dia: ";
    cin >> dia;
    cout << "Mes: ";
    cin >> mes;
    cout << "Anio: ";
    cin >> anio;

    if ((mes == 3 && dia >= 21) || mes == 4 || mes == 5 || (mes == 6 && dia < 21)) {
        cout << "Otono" << endl;
    } else if ((mes == 6 && dia >= 21) || mes == 7 || mes == 8 || (mes == 9 && dia < 21)) {
        cout << "Invierno" << endl;
    } else if ((mes == 9 && dia >= 21) || mes == 10 || mes == 11 || (mes == 12 && dia < 21)) {
        cout << "Primavera" << endl;
    } else {
        cout << "Verano" << endl;
    }

    return 0;
}
