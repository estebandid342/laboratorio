#include <iostream>
#include <string>
using namespace std;

const int MAX = 100;

void mostrarMenu();
void registrarAlumno(string nombres[], double notas[], int &n);
void listarAlumnos(const string nombres[], const double notas[], int n);
void ordenarAlfabeticamente(string nombres[], double notas[], int n);
void mostrarNotaMasAlta(const string nombres[], const double notas[], int n);
double calcularPromedio(const double notas[], int n);

int main() {
    string nombres[MAX];
    double notas[MAX];
    int n = 0;
    int opcion;

    do {
        mostrarMenu();
        cin >> opcion;

        switch (opcion) {
            case 1:
                registrarAlumno(nombres, notas, n);
                break;
            case 2:
                listarAlumnos(nombres, notas, n);
                break;
            case 3:
                ordenarAlfabeticamente(nombres, notas, n);
                break;
            case 4:
                mostrarNotaMasAlta(nombres, notas, n);
                break;
            case 5:
                if (n == 0) {
                    cout << "\nNo hay alumnos registrados.\n";
                } else {
                    cout << "\nEl promedio general es: " << calcularPromedio(notas, n) << endl;
                }
                break;
            case 6:
                cout << "\nSaliendo del programa...\n";
                break;
            default:
                cout << "\nOpcion no valida. Intente de nuevo.\n";
        }
    } while (opcion != 6);

    return 0;
}

void mostrarMenu() {
    cout << "\n--- MENU DE GESTION DE ALUMNOS ---\n";
    cout << "1) Registrar alumno y nota\n";
    cout << "2) Listar alumnos\n";
    cout << "3) Ordenar alfabeticamente por nombre\n";
    cout << "4) Mostrar alumno(s) con la nota mas alta\n";
    cout << "5) Calcular promedio de notas\n";
    cout << "6) Salir\n";
    cout << "Seleccione una opcion: ";
}

void registrarAlumno(string nombres[], double notas[], int &n) {
    if (n >= MAX) {
        cout << "\nCapacidad maxima alcanzada.\n";
        return;
    }
    cout << "\nNombre del alumno: ";
    cin >> nombres[n];
    do {
        cout << "Nota (0 a 100): ";
        cin >> notas[n];
    } while (notas[n] < 0 || notas[n] > 100);
    n++;
    cout << "Alumno registrado correctamente.\n";
}

void listarAlumnos(const string nombres[], const double notas[], int n) {
    if (n == 0) {
        cout << "\nNo hay alumnos registrados.\n";
        return;
    }
    cout << "\n--- LISTA DE ALUMNOS ---\n";
    for (int i = 0; i < n; i++) {
        cout << i + 1 << ". " << nombres[i] << " -> Nota: " << notas[i] << endl;
    }
}

void ordenarAlfabeticamente(string nombres[], double notas[], int n) {
    if (n == 0) {
        cout << "\nNo hay alumnos para ordenar.\n";
        return;
    }
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (nombres[j] > nombres[j + 1]) {
                string tempNom = nombres[j];
                nombres[j] = nombres[j + 1];
                nombres[j + 1] = tempNom;

                double tempNota = notas[j];
                notas[j] = notas[j + 1];
                notas[j + 1] = tempNota;
            }
        }
    }
    cout << "\nLista ordenada alfabeticamente con exito.\n";
}

void mostrarNotaMasAlta(const string nombres[], const double notas[], int n) {
    if (n == 0) {
        cout << "\nNo hay alumnos registrados.\n";
        return;
    }
    double maxNota = notas[0];
    for (int i = 1; i < n; i++) {
        if (notas[i] > maxNota) {
            maxNota = notas[i];
        }
    }
    cout << "\n--- NOTA MAS ALTA (" << maxNota << ") ---\n";
    for (int i = 0; i < n; i++) {
        if (notas[i] == maxNota) {
            cout << "- " << nombres[i] << endl;
        }
    }
}

double calcularPromedio(const double notas[], int n) {
    double suma = 0;
    for (int i = 0; i < n; i++) {
        suma += notas[i];
    }
    return suma / n;
}
