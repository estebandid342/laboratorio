#include <iostream>
#include <cmath>

using namespace std;

void resolverCuadratica(double a, double b, double c) {
    if (a == 0) {
        if (b != 0) {
            cout << "Ecuación de primer grado. X = " << -c / b << endl;
        } else {
            cout << "Ecuación no válida." << endl;
        }
        return;
    }
    double disc = b * b - 4 * a * c;
    if (disc > 0) {
        double x1 = (-b + sqrt(disc)) / (2 * a);
        double x2 = (-b - sqrt(disc)) / (2 * a);
        cout << "Dos raíces reales: X1 = " << x1 << ", X2 = " << x2 << endl;
    } else if (disc == 0) {
        double x = -b / (2 * a);
        cout << "Raíz doble: X = " << x << endl;
    } else {
        double realPart = -b / (2 * a);
        double imagPart = sqrt(-disc) / (2 * a);
        cout << "Dos raíces complejas: X1 = " << realPart << " + " << imagPart << "i, X2 = " << realPart << " - " << imagPart << "i" << endl;
    }
}

int main() {
    resolverCuadratica(1, -5, 6);
    resolverCuadratica(1, -2, 1);
    resolverCuadratica(1, 1, 1);
    return 0;
}
