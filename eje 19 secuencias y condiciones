#include <iostream>
using namespace std;

int main() {
    int d1, m1, d2, m2, totalDias1, totalDias2, dif, meses, dias;

    cout << "Dia inicial: ";
    cin >> d1;
    cout << "Mes inicial: ";
    cin >> m1;
    cout << "Dia final: ";
    cin >> d2;
    cout << "Mes final: ";
    cin >> m2;

    totalDias1 = m1 * 30 + d1;
    totalDias2 = m2 * 30 + d2;
    dif = totalDias2 - totalDias1;

    if (dif < 0) {
        dif = -dif;
    }

    meses = dif / 30;
    dias = dif % 30;

    cout << "Meses: " << meses << endl;
    cout << "Dias: " << dias << endl;

    return 0;
}
