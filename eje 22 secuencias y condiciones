#include <iostream>
#include <cmath>
using namespace std;

int main() {
    double a, b, c, disc, x1, x2, real, imag;

    cout << "a: ";
    cin >> a;
    cout << "b: ";
    cin >> b;
    cout << "c: ";
    cin >> c;

    if (a == 0 && b == 0) {
        if (c == 0) {
            cout << "Identidad" << endl;
        } else {
            cout << "Sin solucion" << endl;
        }
    } else if (a == 0) {
        x1 = -c / b;
        cout << "Ecuacion lineal" << endl;
        cout << "X: " << x1 << endl;
    } else {
        disc = b * b - 4 * a * c;
        if (disc > 0) {
            x1 = (-b + sqrt(disc)) / (2 * a);
            x2 = (-b - sqrt(disc)) / (2 * a);
            cout << "Dos raices reales distintas" << endl;
            cout << "X1: " << x1 << endl;
            cout << "X2: " << x2 << endl;
        } else if (disc == 0) {
            x1 = -b / (2 * a);
            cout << "Raiz real doble" << endl;
            cout << "X: " << x1 << endl;
        } else {
            real = -b / (2 * a);
            imag = fabs(sqrt(-disc) / (2 * a));
            cout << "Raices complejas conjugadas" << endl;
            cout << "X1: " << real << " + " << imag << "i" << endl;
            cout << "X2: " << real << " - " << imag << "i" << endl;
        }
    }

    return 0;
}
