#include <iostream>
using namespace std;

int main() {
    int n, s = 0;

    cout << "N: ";
    cin >> n;

    for (int i = 1; i <= n; i++) {
        if (i % 2 != 0) {
            s = s + i;
        } else {
            s = s - i;
        }
    }

    cout << "Suma: " << s << endl;

    return 0;
}
