#include <iostream>
#include <string>

using namespace std;

void LITERAL(int dia, int mes, int ano) {
    string meses[] = {
        "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
        "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
    };

    int anioCompleto = (ano < 100) ? (1900 + ano) : ano;

    if (mes >= 1 && mes <= 12) {
        cout << dia << " de " << meses[mes] << " de " << anioCompleto << endl;
    } else {
        cout << "Mes no válido" << endl;
    }
}

int main() {
    LITERAL(20, 5, 99);
    return 0;
}
