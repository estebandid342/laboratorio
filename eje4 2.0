Algoritmo sin_titulo
	Definir base, altura, area Como Real
	Escribir "introduce la altua del rectangulo"
	Leer altura
	Escribir "introduce la base del rectangulo"
	leer base
	area = base * altura
	Escribir "la base del rectangulo es ", base 
	Escribir "la altura del rectangulo es ", altura
	Escribir "el area del rectangulo es  ", area 
FinAlgoritmo
