#include <iostream>
#include <string>

using namespace std;

void registrar(string &nombre, string &apellido);
string unirNombre(string nombre, string apellido);
int contarCaracteres(string nombre, string apellido);
void mostrar(string completo, int cantidad);

int main() {
    string nombre, apellido;

    registrar(nombre, apellido);

    string nombreCompleto = unirNombre(nombre, apellido);
    int cantidadLetras = contarCaracteres(nombre, apellido);

    mostrar(nombreCompleto, cantidadLetras);

    return 0;
}

void registrar(string &nombre, string &apellido) {
    cout << "Nombre: ";
    getline(cin, nombre);
    cout << "Apellido: ";
    getline(cin, apellido);
}

string unirNombre(string nombre, string apellido) {
    return nombre + " " + apellido;
}

int contarCaracteres(string nombre, string apellido) {
    return nombre.length() + apellido.length();
}

void mostrar(string completo, int cantidad) {
    cout << "Nombre completo: " << completo << " | Letras: " << cantidad << endl;
}
