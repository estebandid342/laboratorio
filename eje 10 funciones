#include <iostream>
#include <string>
#include <vector>

void convertirARomano(int num) {
    struct Roman {
        int valor;
        std::string simbolo;
    };

    std::vector<Roman> tabla = {
        {1000, "M"}, {900, "CM"}, {500, "D"}, {400, "CD"},
        {100, "C"},  {90, "XC"},  {50, "L"},  {40, "XL"},
        {10, "X"},   {9, "IX"},   {5, "V"},   {4, "IV"},
        {1, "I"}
    };

    std::string resultado = "";
    for (const auto& item : tabla) {
        while (num >= item.valor) {
            resultado += item.simbolo;
            num -= item.valor;
        }
    }
    std::cout << "Numero Romano: " << resultado << std::endl;
}
