#include <iostream>
#include <string>
#include <cmath>

long long binarioADecimal(const std::string& binario) {
    long long decimal = 0;
    int n = binario.length();
    for (int i = 0; i < n; ++i) {
        if (binario[n - 1 - i] == '1') {
            decimal += std::pow(2, i);
        }
    }
    return decimal;
}

int main() {
    std::string b = "1101"; // 13 en decimal
    std::cout << "Decimal: " << binarioADecimal(b) << std::endl;
    return 0;
}
