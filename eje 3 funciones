#include <iostream>
#include <cmath>

using namespace std;

long long FAC(int n) {
    long long f = 1;
    for (int i = 1; i <= n; i++) f *= i;
    return f;
}

double POTEN(double x, double y) {
    return pow(x, y);
}

double sumaSerie1(int X, int N) {
    double suma = 0.0;
    for (int i = 1; i <= N; i++) {
        suma += POTEN(X, i) / FAC(i);
    }
    return suma;
}

int main() {
    int X = 2, N = 4;
    cout << "Suma de la serie: " << sumaSerie1(X, N) << endl;
    return 0;
}
