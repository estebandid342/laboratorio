#include <iostream>
using namespace std;

int main() {
    int n, cont = 0;

    cout << "N: ";
    cin >> n;

    for (int i = 1; i <= n; i++) {
        if (n % i == 0) {
            cont++;
        }
    }

    if (cont == 2) {
        cout << "Es primo" << endl;
    } else {
        cout << "No es primo" << endl;
    }

    return 0;
}
