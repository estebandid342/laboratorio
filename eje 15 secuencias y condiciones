#include <iostream>
using namespace std;

int main() {
    float c, f, k, ra;

    cout << "Celsius: ";
    cin >> c;

    f = (c * 9.0 / 5.0) + 32;
    k = c + 273.15;
    ra = (c + 273.15) * 9.0 / 5.0;

    cout << "Fahrenheit: " << f << endl;
    cout << "Kelvin: " << k << endl;
    cout << "Rankine: " << ra << endl;

    return 0;
}
