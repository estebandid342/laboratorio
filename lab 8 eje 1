#include <iostream>

using namespace std;

double leerNota(int numeroEvaluacion) {
    double nota;
    bool error;
    do {
        cout << "Nota " << numeroEvaluacion << " (0-100): ";
        cin >> nota;
        
        error = false;
        if (nota < 0) {
            error = true;
        }
        if (nota > 100) {
            error = true;
        }
        
        if (error) {
            cout << "Error. Ingrese de nuevo: ";
        }
    } while (error);
    return nota;
}

double calcularPromedio(int cantidad) {
    double suma = 0;
    for (int i = 1; i <= cantidad; i++) {
        suma += leerNota(i);
    }
    return suma / cantidad;
}

bool determinarAprobacion(double promedio) {
    return promedio >= 51.0;
}

void mostrarResultados(double promedio, bool aprobado) {
    cout << "\nPromedio: " << promedio << endl;
    if (aprobado) {
        cout << "Estado: APROBADO" << endl;
    } else {
        cout << "Estado: REPROBADO" << endl;
    }
}

int main() {
    int cantidadEvaluaciones;
    
    cout << "Cantidad de evaluaciones: ";
    cin >> cantidadEvaluaciones;

    if (cantidadEvaluaciones <= 0) {
        cout << "Invalido." << endl;
        return 0;
    }

    double promedio = calcularPromedio(cantidadEvaluaciones);
    bool aprobado = determinarAprobacion(promedio);

    mostrarResultados(promedio, aprobado);

    return 0;
}
