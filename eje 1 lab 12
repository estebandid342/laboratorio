    
#include <iostream>
#include <string>
using namespace std;


void Leer(string &cadena, string &subcadena) {
    cout << "Ingrese la cadena principal: ";
    getline(cin, cadena);

    cout << "Ingrese la subcadena a buscar: ";
    getline(cin, subcadena);
}

int BuscarSubCadena(string cadena, string subcadena) {

    size_t posicion = cadena.find(subcadena);

    if (posicion != string::npos) {
        return (int)posicion;
    }

    return -1;
}

void Mostrar(int resultado) {

    if (resultado != -1) {
        cout << "La subcadena se encuentra en la posicion: "
             << resultado << endl;
    } else {
        cout << "La subcadena no fue encontrada." << endl;
    }
}


int main() {

    string texto, palabra;
    int resultado;

    Leer(texto, palabra);

    resultado = BuscarSubCadena(texto, palabra);

    Mostrar(resultado);

    return 0;
}

