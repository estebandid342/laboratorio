#include <iostream>
using namespace std;

int main(){
    int n;
    cout << "introduce un numero";
    cin >> n;
    if(n>0){
        int suma = 0;
        while(n > 0){
            suma += n %10;
            n = n/10;
        }
        cout<<"la suma es de " << suma << endl;
    }else{
        cout<<"intetar de nuevo";
    }
    }
