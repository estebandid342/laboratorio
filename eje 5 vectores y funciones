#include <iostream>
using namespace std;

const int MAX = 100;

void leerVector(int arr[], int n);
void mostrarVector(const int arr[], int n);
bool esCapicua(const int arr[], int n);

int main() {
    int n;
    int vector[MAX];

    do {
        cout << "Ingrese la cantidad de elementos (n > 0 y <= " << MAX << "): ";
        cin >> n;
    } while (n <= 0 || n > MAX);

    leerVector(vector, n);

    cout << "\nVector ingresado:\n";
    mostrarVector(vector, n);

    if (esCapicua(vector, n)) {
        cout << "\nEl vector ES capicua." << endl;
    } else {
        cout << "\nEl vector NO es capicua." << endl;
    }

    return 0;
}

void leerVector(int arr[], int n) {
    cout << "Ingrese " << n << " numeros enteros:\n";
    for (int i = 0; i < n; i++) {
        cout << "Elemento [" << i << "]: ";
        cin >> arr[i];
    }
}

void mostrarVector(const int arr[], int n) {
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;
}

bool esCapicua(const int arr[], int n) {
    for (int i = 0; i < n / 2; i++) {
        if (arr[i] != arr[n - 1 - i]) {
            return false;
        }
    }
    return true;
}
