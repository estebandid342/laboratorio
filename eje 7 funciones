#include <iostream>

using namespace std;

long long FAC(int n) {
    if (n < 0) return 0;
    long long f = 1;
    for (int i = 1; i <= n; i++) f *= i;
    return f;
}

long long Combi(int n, int r) {
    if (r < 0 || r > n) return 0;
    return FAC(n) / (FAC(r) * FAC(n - r));
}

int main() {
    int n = 5, r = 2;
    cout << "Combi(" << n << ", " << r << ") = " << Combi(n, r) << endl;
    return 0;
}
