#include <iostream>

using namespace std;

long long FAC(int n) {
    if (n < 0) return 0;
    long long f = 1;
    for (int i = 1; i <= n; i++) f *= i;
    return f;
}

int main() {
    int n = 5, r = 2;
    long long C = FAC(n) / (FAC(r) * FAC(n - r));
    cout << "C(" << n << ", " << r << ") = " << C << endl;
    return 0;
}
