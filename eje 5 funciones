#include <iostream>

using namespace std;

void SISTEMA(double A, double B, double C, double D, double E, double F, double &X, double &Y) {
    double det = A * E - B * D;
    if (det != 0) {
        X = (B * F - C * E) / det;
        Y = (C * D - A * F) / det;
    } else {
        cout << "El sistema no tiene solución única." << endl;
        X = 0;
        Y = 0;
    }
}

int main() {
    double X, Y;
    SISTEMA(1, 2, 3, 4, 5, 6, X, Y);
    cout << "Solución del sistema: X = " << X << ", Y = " << Y << endl;
    return 0;
}
